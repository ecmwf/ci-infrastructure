#!/bin/bash
{# SPDX-FileCopyrightText: 2026 European Centre for Medium-Range Weather Forecasts (ECMWF)
   SPDX-License-Identifier: Apache-2.0

   Build, install and test one Python project on a GitHub runner: a wheel, installed with the deps' wheels, then pytest.

   Also the base of python-atos.sh.j2.

   The wheel goes to $CI_INSTALL_PREFIX/wheels, which is the artifact a
   downstream leg installs. A dep's wheels are found in <prefix>/wheels of each
   prefix on CMAKE_PREFIX_PATH (";" on a runner, ":" on HPC). #}
{% import "ci-infrastructure/python.j2" as py %}
{% block header %}
{% endblock %}

wheels="$CI_INSTALL_PREFIX/wheels"

{% block set_environment %}{% endblock %}
{% block python %}
{% if python_version %}
{{ py.get_python_via_uv(python_version) }}
{% else %}
uv venv --clear "${TMPDIR:-/tmp}/ci-python"
. "${TMPDIR:-/tmp}/ci-python/bin/activate"
{% endif %}
{% endblock %}
{% block preflight %}
echo "Using: $(command -v python) ($(python --version))"
echo "Using: $(command -v uv) ($(uv --version))"
{% endblock %}

{% block build %}
# A version from git (setuptools-scm, hatch-vcs) needs the tags, which a shallow checkout lacks.
git_src=(git -c safe.directory="$CI_SOURCE_DIR" -C "$CI_SOURCE_DIR")
if [ "$("${git_src[@]}" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then
  "${git_src[@]}" fetch --quiet --unshallow --tags ||
    echo "::warning::could not unshallow $CI_SOURCE_DIR; a version derived from git tags may be wrong"
fi
rm -rf "$wheels"
uv build --wheel --out-dir "$wheels" "$CI_SOURCE_DIR"
{% endblock %}

{% block install %}
dep_wheels=()
IFS=';:' read -ra dep_prefixes <<<"${CMAKE_PREFIX_PATH:-}"
for prefix in ${dep_prefixes[@]+"${dep_prefixes[@]}"}; do
  for whl in "$prefix"/wheels/*.whl; do
    if [ -e "$whl" ]; then dep_wheels+=("$whl"); fi
  done
done
own_wheels=("$wheels"/*.whl)
if [ ! -e "${own_wheels[0]}" ] || [ -n "${own_wheels[1]:-}" ]; then
  echo "::error::expected one wheel in $wheels, found: ${own_wheels[*]}"
  exit 1
fi
# The +-expansions keep empty arrays working under set -u in bash < 4.4.
# One resolve, so the deps' wheels win over the same packages from the index.
uv pip install ${dep_wheels[@]+"${dep_wheels[@]}"} "${own_wheels[0]}{{ ('[' ~ extras ~ ']') if extras | default('') else '' }}" {% block test_requirements %}{% if tests %}pytest{% endif %}{% endblock %}

{% endblock %}

{% if tests %}
{% block test %}
cd "$CI_SOURCE_DIR"
python -m pytest {{ pytest_args | default("") }}
{% endblock %}

{% endif %}
{% block publish %}{% endblock %}
