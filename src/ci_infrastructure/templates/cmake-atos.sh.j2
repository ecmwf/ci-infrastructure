{% extends "ci-infrastructure/cmake-runner.sh.j2" %}
{# SPDX-FileCopyrightText: 2026 European Centre for Medium-Range Weather Forecasts (ECMWF)
   SPDX-License-Identifier: Apache-2.0

   The runner template plus what a SLURM job on Atos needs: the #SBATCH header,
   the modules, the node-local build tree and the install archive.

   A change to what gets built must bump _github_api.HPC_TEMPLATE_VERSION;
   resources and parallelism change no artifact and do not.

   A leg field read through `| default(...)` may be omitted from the manifest. #}
{% set ntasks = ntasks | default(8) %}
{# 64 CPUs, as the old downstream CI; ntasks only splits them into MPI ranks. #}
{% set cpus_per_task = cpus_per_task | default([64 // ntasks, 1] | max) %}
{% block header %}
{% block sbatch %}
#SBATCH --qos={{ qos | default("nf") }}
#SBATCH --nodes={{ nodes | default(1) }}
#SBATCH --ntasks={{ ntasks }}
#SBATCH --cpus-per-task={{ cpus_per_task }}
{% if gpus_per_task | default("") %}
#SBATCH --gpus-per-task={{ gpus_per_task }}
{% endif %}
#SBATCH --mem={{ mem | default("64GB") }}
{% if ssdtmp | default("30G") %}
#SBATCH --gres=ssdtmp:{{ ssdtmp | default("30G") }}
{% endif %}
#SBATCH --time={{ time | default("01:00:00") }}
{% endblock %}

{% for m in modules %}
module {{ m }}
{% endfor %}
{% endblock %}

{% block setup %}
build="${TMPDIR:-/tmp}/build"
jobs="${SLURM_CPUS_ON_NODE:-{{ ntasks * cpus_per_task }}}"
test_jobs="${SLURM_CPUS_PER_TASK:-{{ cpus_per_task }}}"
install_root="$CI_INSTALL_PREFIX"
gen_flag=""
if command -v ninja >/dev/null 2>&1; then gen_flag="-GNinja"; fi
{% endblock %}

{% block publish %}

# The fetcher takes the artifact from CI_INSTALL_ARCHIVE, not from the install
# tree; .part + mv so it only ever appears complete.
mkdir -p "$(dirname "$CI_INSTALL_ARCHIVE")"
tar -cf - -C "$install_root" . | zstd -T0 -q -o "$CI_INSTALL_ARCHIVE.part"
mv "$CI_INSTALL_ARCHIVE.part" "$CI_INSTALL_ARCHIVE"
{% endblock %}
