#
# Install-tree checks for a release, in plain bash: actions/install-test-package sources this
# file, and a template may `include` it unchanged (it holds no Jinja syntax; a test keeps it so).
# Each function prints what it finds to stderr and returns 1 on a finding.

# ci_release_is_elf FILE
ci_release_is_elf() {
  [ -f "$1" ] && [ "$(head -c 4 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "7f454c46" ]
}

# ci_release_under PATH PREFIX...: PATH is one of the prefixes, or below one (text only).
ci_release_under() {
  local path="$1" d
  shift
  for d in "$@"; do
    case "$path" in
      "$d"|"$d"/*) return 0 ;;
    esac
  done
  return 1
}

# ci_release_prefixes NAME ARG...: the absolute ARGs, trailing slashes stripped, into array NAME;
# an empty ARG is skipped (an unset variable must not allow, or deny, everything). A relative
# ARG, `/` or `//` is a configuration error: it would match every path.
ci_release_prefixes() {
  local -n _ci_out="$1"
  local p
  shift
  _ci_out=()
  for p in "$@"; do
    [ -n "$p" ] || continue
    while [ "$p" != / ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done
    case "$p" in
      /?*) _ci_out+=("$p") ;;
      *)
        echo "ci-release: configuration error: '$p' is not an absolute path below /" >&2
        return 1
        ;;
    esac
  done
}

# ci_release_add_canonical NAME: append to array NAME each entry's canonical form (readlink -m:
# symlinks, `//` and `.` resolved) where it differs, so a denied tree is matched under either name.
# One whose canonical form is `/` (`/scratch/..`) is a configuration error, as `/` is.
ci_release_add_canonical() {
  local -n _ci_arr="$1"
  local p c
  for p in "${_ci_arr[@]}"; do
    c="$(readlink -m -- "$p" 2>/dev/null || true)"
    if [ "$c" = / ]; then
      echo "ci-release: configuration error: '$p' is /" >&2
      return 1
    fi
    if [ -n "$c" ] && [ "$c" != "$p" ]; then _ci_arr+=("$c"); fi
  done
}

# ci_release_check_runpath ROOT ALLOWED_PREFIX... [-- DENIED_PREFIX...]
# Every RUNPATH/RPATH entry of every ELF file under ROOT is $ORIGIN-relative, or an absolute path
# under an allowed prefix with no `.`, `..` or empty component (`/opt/ecmwf/../../usr/lib64` escapes
# it; `/usr/local/apps//ci` would dodge a denied `/usr/local/apps/ci`).
# An entry under a denied prefix (a CI or node-local tree, gone after the job) is a finding even
# when an allowed prefix covers it. An empty entry (`:/opt/ecmwf/lib`) is a finding: the loader
# reads it as the current directory. Prefixes are compared as text.
ci_release_check_runpath() {
  local root="$1" bad=0 f entry ok d
  shift
  local -a raw_allowed=() raw_denied=() allowed=() denied=()
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do raw_allowed+=("$1"); shift; done
  if [ $# -gt 0 ]; then shift; raw_denied=("$@"); fi
  ci_release_prefixes allowed "${raw_allowed[@]}" || return 1
  ci_release_prefixes denied "${raw_denied[@]}" || return 1
  ci_release_add_canonical denied || return 1
  while IFS= read -r -d '' f; do
    ci_release_is_elf "$f" || continue
    while IFS= read -r entry; do
      while [ "$entry" != / ] && [ "${entry%/}" != "$entry" ]; do entry="${entry%/}"; done
      if [ -z "$entry" ]; then
        echo "ci-release: $f: empty RUNPATH entry (the loader searches the current directory)" >&2
        bad=1
        continue
      fi
      ok=false
      # shellcheck disable=SC2016 # the literal $ORIGIN of the dynamic loader
      case "$entry" in
        '$ORIGIN'|'$ORIGIN'/*|'${ORIGIN}'|'${ORIGIN}'/*) ok=true ;;
        /*)
          case "$entry/" in
            */./*|*/../*|*//*) ;;
            *)
              for d in "${denied[@]}"; do
                if ci_release_under "$entry" "$d"; then
                  echo "ci-release: $f: RUNPATH entry '$entry' is in $d, a CI or node-local tree gone after the job" >&2
                  bad=1
                  continue 2
                fi
              done
              if ci_release_under "$entry" "${allowed[@]}"; then ok=true; fi
              ;;
          esac
          ;;
      esac
      if ! $ok; then
        echo "ci-release: $f: RUNPATH entry '$entry' is neither \$ORIGIN-relative nor under: ${allowed[*]}" >&2
        bad=1
      fi
    done < <(readelf -d "$f" 2>/dev/null | sed -n 's/.*(\(RUNPATH\|RPATH\)).*\[\(.*\)\]$/\2/p' | tr ':' '\n')
  done < <(find "$root" -type f -print0)
  return "$bad"
}

# ci_release_check_ldd ROOT [DENIED_PREFIX...]
# No ELF file under ROOT has a library ldd cannot find, without LD_LIBRARY_PATH, nor one it finds
# under a denied prefix (a CI or node-local tree, gone after the job). ROOT itself may sit in a
# denied tree (the install test unpacks into $TMPDIR): a library whose resolved path (readlink -f:
# `..` and symlinks followed, so `$ORIGIN/../../..` cannot escape) is under ROOT is accepted.
ci_release_check_ldd() {
  local root="$1" bad=0 f missing lib real d out real_root
  shift
  local -a denied=()
  ci_release_prefixes denied "$@" || return 1
  ci_release_add_canonical denied || return 1
  real_root="$(readlink -f -- "$root" 2>/dev/null || printf '%s' "$root")"
  while IFS= read -r -d '' f; do
    ci_release_is_elf "$f" || continue
    out="$(env -u LD_LIBRARY_PATH ldd "$f" 2>/dev/null || true)"
    missing="$(printf '%s\n' "$out" | grep 'not found' || true)"
    if [ -n "$missing" ]; then
      echo "ci-release: $f does not load:" >&2
      printf '%s\n' "$missing" >&2
      bad=1
    fi
    # The resolved paths: `libx.so => /p (0x...)`, and `\t/p (0x...)` for an absolute DT_NEEDED.
    while IFS= read -r lib; do
      [ -n "$lib" ] || continue
      real="$(readlink -f -- "$lib" 2>/dev/null || printf '%s' "$lib")"
      if ci_release_under "$real" "$real_root"; then continue; fi
      for d in "${denied[@]}"; do
        if ci_release_under "$lib" "$d" || ci_release_under "$real" "$d"; then
          if [ "$real" != "$lib" ]; then lib="$lib ($real)"; fi
          echo "ci-release: $f loads $lib, in $d, a CI or node-local tree gone after the job" >&2
          bad=1
          break
        fi
      done
    done < <(printf '%s\n' "$out" | sed -n -e 's/^.* => \(\/.*\) (0x[0-9a-f]*)$/\1/p' -e 's/^[[:space:]]*\(\/.*\) (0x[0-9a-f]*)$/\1/p')
  done < <(find "$root" -type f -print0)
  return "$bad"
}

# ci_release_check_leaks ROOT [EXTRA_PATTERN...]
# No build-machine path in the installed CMake config, pkg-config or share/ files.
ci_release_check_leaks() {
  local root="$1" p hits
  shift
  local -a args=()
  for p in '/__w/' '/_temp/' 'github-ci/' '/staging/' '/tmpdirs/' '/tmp/build' '/github/home' "$@"; do
    if [ -n "$p" ]; then args+=(-e "$p"); fi
  done
  hits="$(find "$root" -type f \( -name '*.cmake' -o -name '*.pc' -o -path '*/share/*' \) -print0 \
    | xargs -0 -r grep -I -n -F "${args[@]}" || true)"
  if [ -n "$hits" ]; then
    echo "ci-release: build paths leaked into the install tree:" >&2
    printf '%s\n' "$hits" >&2
    return 1
  fi
}

# ci_release_check_paths PREFIX  (paths on stdin, e.g. `rpm -qlp x.rpm`)
# Every path is under PREFIX, or one of its parent directories, or one of rpmbuild's
# build-id links (/usr/lib/.build-id/xx/<hex>[.N], which v2's rpms ship too). Run it after
# the package is installed: a build-id entry must be an installed symlink into PREFIX.
ci_release_check_paths() {
  local prefix="$1" bad=0 path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
      "$prefix"|"$prefix"/*) continue ;;
      /usr/lib/.build-id|/usr/lib/.build-id/[0-9a-f][0-9a-f])
        # CI_RELEASE_TEST_ROOT: tests only, an empty default reads the real file system.
        if [ -d "${CI_RELEASE_TEST_ROOT:-}$path" ] && [ ! -L "${CI_RELEASE_TEST_ROOT:-}$path" ]; then
          continue
        fi
        echo "ci-release: $path is not an installed directory" >&2
        bad=1
        continue
        ;;
    esac
    if printf '%s\n' "$path" | grep -Eqx '/usr/lib/\.build-id/[0-9a-f]{2}/[0-9a-f]{30,62}(\.[0-9]+)?'; then
      local root="${CI_RELEASE_TEST_ROOT:-}" target
      target=$(readlink -f -- "$root$path" 2>/dev/null) || target=
      if [ -L "$root$path" ] && case "$target" in "$root$prefix"/*) true ;; *) false ;; esac; then
        continue
      fi
      echo "ci-release: $path is not an installed symlink into $prefix" >&2
      bad=1
      continue
    fi
    case "$prefix/" in
      "$path"/*) continue ;;
    esac
    echo "ci-release: $path is outside $prefix" >&2
    bad=1
  done
  return "$bad"
}

# ci_release_json STRING: STRING as a JSON string, control characters dropped.
ci_release_json() {
  printf '"%s"' "$(printf '%s' "$1" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}
