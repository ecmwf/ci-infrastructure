#!/bin/bash
{# SPDX-FileCopyrightText: 2026 European Centre for Medium-Range Weather Forecasts (ECMWF)
   SPDX-License-Identifier: Apache-2.0

   Configure, build, test and install a CMake project on a GitHub runner.

   Also the base of cmake-atos.sh.j2. Any change here must bump
   _github_api.HPC_TEMPLATE_VERSION. #}
{% block header %}
{% endblock %}

{% block setup %}
build="${CI_BUILD_DIR:-${TMPDIR:-/tmp}/build}"
jobs="$(nproc 2>/dev/null || sysctl -n hw.ncpu)"
# CMake's default generator, as cmake-build used: some images ship a ninja too old for every project.
gen_flag=""
{% endblock %}

{% block set_environment %}{% endblock %}
{% block preflight %}
echo "Using: $(command -v {{ c_compiler_binary | sh }}) ($({{ c_compiler_binary | sh }} --version | head -1))"
echo "Using: $(command -v {{ cxx_compiler_binary | sh }}) ($({{ cxx_compiler_binary | sh }} --version | head -1))"
{% if fortran_compiler_binary %}
echo "Using: $(command -v {{ fortran_compiler_binary | sh }}) ($({{ fortran_compiler_binary | sh }} --version | head -1))"
{% endif %}
echo "Using: $(command -v cmake) ($(cmake --version | head -1))"
{% endblock %}

{% block configure %}
# shellcheck disable=SC2086
cmake --preset {{ (options or "ci") | sh }} -S "$CI_SOURCE_DIR" -B "$build" $gen_flag \
  -DCMAKE_BUILD_TYPE={{ build_type | sh }} \
  -DCMAKE_C_COMPILER="$(command -v {{ c_compiler_binary | sh }})" \
  -DCMAKE_CXX_COMPILER="$(command -v {{ cxx_compiler_binary | sh }})" \
{% if fortran_compiler_binary %}
  -DCMAKE_Fortran_COMPILER="$(command -v {{ fortran_compiler_binary | sh }})" \
{% endif %}
{% block cmake_args %}{% endblock %}
  -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
  -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH" \
  -DCMAKE_INSTALL_PREFIX="$CI_INSTALL_PREFIX"
{% endblock %}

{% block build %}
cmake --build "$build" --parallel "$jobs"
{% endblock %}

{% if tests %}
{% block test %}
{% if ctest_args %}
ctest --test-dir "$build" --output-on-failure {{ ctest_args }}
{% else %}
ctest --test-dir "$build" --output-on-failure -j "$jobs"
{% endif %}
{% endblock %}

{% endif %}
{% block install %}
cmake --install "$build"
{% endblock %}
{% block rust %}
{% if rust_compiler %}
# The Rust bindings, built against the install above: the -sys crates' `system` mode.
rust_version={{ rust_compiler | replace("rust-", "", 1) | sh }}
case "$(rustc --version | awk '{print $2}')" in
  "$rust_version" | "$rust_version".*) ;;
  *) echo "::error::$(rustc --version) is not {{ rust_compiler }}"; exit 1 ;;
esac
echo "Using: $(command -v cargo) ($(cargo --version))"
export CC="$(command -v {{ c_compiler_binary | sh }})" CXX="$(command -v {{ cxx_compiler_binary | sh }})"
host="$(rustc -vV | sed -n 's/^host: //p')"
export "CARGO_TARGET_$(tr 'a-z-' 'A-Z_' <<<"$host")_LINKER=$CC"
export CMAKE_PREFIX_PATH="$CI_INSTALL_PREFIX${CMAKE_PREFIX_PATH:+;$CMAKE_PREFIX_PATH}"
# cargo links against the prefixes; the tests also have to load from them.
for p in ${CMAKE_PREFIX_PATH//;/ }; do
  for d in "$p/lib64" "$p/lib"; do
    if [ -d "$d" ]; then LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$d"; fi
  done
done
export LD_LIBRARY_PATH
# Git dependencies named by ssh URL, fetched anonymously.
export CARGO_NET_GIT_FETCH_WITH_CLI=true GIT_CONFIG_COUNT=1 \
  GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_0=ssh://git@github.com/
export CARGO_TARGET_DIR="${TMPDIR:-/tmp}/cargo-target"
cd "$CI_SOURCE_DIR/{% block cargo_workspace %}rust{% endblock %}"
{% block cargo %}
cargo fmt --all --check
cargo clippy --workspace --all-targets {% block cargo_features %}--no-default-features --features system{% endblock %} -- \
  -W clippy::all -W clippy::pedantic -W clippy::nursery -W clippy::unwrap_used \
  -A clippy::module_name_repetitions -A clippy::missing_errors_doc -D warnings
cargo test --workspace {{ self.cargo_features() }}
{% block cargo_doc %}
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps {{ self.cargo_features() }}
{% endblock %}
{% endblock %}
{% endif %}
{% endblock %}
{% block publish %}{% endblock %}
